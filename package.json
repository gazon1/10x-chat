{
  "name": "@gazon1/10x-chat",
  "version": "0.11.6",
  "description": "CLI to chat with web AI agents (ChatGPT, Gemini, Claude, Grok, Perplexity, DeepSeek) via browser automation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "10x-chat": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "bun run src/bin/cli.ts",
    "start": "bun run build && node dist/bin/cli.js",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build",
    "postinstall": "npx cloakbrowser install"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "chatgpt",
    "gemini",
    "claude",
    "grok",
    "perplexity",
    "deepseek",
    "cli",
    "browser-automation",
    "playwright"
  ],
  "license": "MIT",
  "author": "Drobin Max (gazon1)",
  "repository": {
    "type": "git",
    "url": "https://github.com/gazon1/10x-chat.git"
  },
  "homepage": "https://github.com/gazon1/10x-chat#readme",
  "bugs": {
    "url": "https://github.com/gazon1/10x-chat/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@napi-rs/keyring": "2.1.2",
    "chalk": "^5.4.1",
    "clipboardy": "^4.0.0",
    "cloakbrowser": "^0.4.2",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "json5": "^2.2.3",
    "playwright": "^1.65.0",
    "playwright-core": "^1.65.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "knip": "^6.45.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "bun@1.3.14"
}
